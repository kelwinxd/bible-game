# Copie para .env.production e preencha com a chave do seu projeto no PostHog (Project settings → Project API key).
# A chave é pública (vai no código do navegador de qualquer jeito); sem ela, o jogo não envia nada.
VITE_POSTHOG_KEY=phc_coloque_sua_chave_aqui
# Região do projeto: https://us.i.posthog.com (EUA) ou https://eu.i.posthog.com (Europa)
VITE_POSTHOG_HOST=https://us.i.posthog.com
